rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data;
    }
    function activeUser() { return signedIn() && profile().active == true; }
    function isAdmin() { return activeUser() && profile().role == 'Administrador'; }
    function isEditor() { return activeUser() && profile().role == 'Editor'; }
    function canEditContent() { return isAdmin() || isEditor(); }

    match /public/marraflabDB {
      allow read: if true;
      allow create: if canEditContent()
        && !request.resource.data.keys().hasAny(['users']);
      allow update: if canEditContent()
        && !request.resource.data.keys().hasAny(['users'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'brandLogos', 'seo', 'services', 'products', 'testimonials',
          'gallery', 'blog', 'whatsapp'
        ])
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['brandLogos', 'seo']));
      allow delete: if false;
    }

    match /userRoles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; // Solo Cloud Functions/Admin SDK.
    }

    match /activity/{entryId} {
      allow read: if canEditContent();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'actorUid','actorName','actorEmail','role','action','section',
          'details','itemId','createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.role == profile().role
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
