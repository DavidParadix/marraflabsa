rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/userRoles/$(request.auth.uid)).data;
    }
    function activeUser() {
      return request.auth != null && profile().active == true
        && profile().role in ['Administrador', 'Editor'];
    }
    match /site-assets/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if activeUser()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if activeUser() && request.auth.uid == uid;
    }
  }
}
